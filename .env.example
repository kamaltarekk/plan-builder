# ─────────────────────────────────────────────────────────────
# Sabika Saving-Plan Tool — environment configuration
# Copy this file to `.env.local` and adjust values as needed.
# All variables are optional; sensible reference defaults are baked in.
# ─────────────────────────────────────────────────────────────

# Reference gold price in EGP per gram (24k / pure gold basis).
# Leave unset to use the built-in reference default.
# VITE_GOLD_PRICE_PER_GRAM=

# Reference silver price in EGP per gram.
# Leave unset to use the built-in reference default.
# VITE_SILVER_PRICE_PER_GRAM=

# Alternatively, provide silver price per troy ounce; it will be
# converted to per-gram automatically (1 oz = 31.1034768 g).
# If both per-gram and per-ounce are set, per-gram takes precedence.
# VITE_SILVER_PRICE_PER_OUNCE=

# ISO timestamp shown as "آخر تحديث للسعر" on the result screen.
# VITE_PRICE_UPDATED_AT=

# Primary CTA install/app link. Defaults to the Sabika smart link.
# VITE_SABIKA_INSTALL_URL=https://sabika.go.link/eBoSi
